# PostgreSQL Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=campus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Roles for RLS and Least Privilege
POSTGRES_FACULTY_USER=campus_faculty
POSTGRES_FACULTY_PASSWORD=faculty_secure_pw
POSTGRES_ADMIN_USER=campus_admin
POSTGRES_ADMIN_PASSWORD=admin_secure_pw

# MongoDB Configuration (Variable Resource Profiles)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_profiles
MONGODB_DB_NAME=campus_profiles

# Authentication and Sessions (jose JWT)
JWT_SECRET=campus_secret_key_minimum_32_characters_for_hs256_jwt_token!

# Application Configuration
NEXT_PUBLIC_APP_NAME="Campus Resource Allocation & Conflict Detection Platform"
NODE_ENV=development
